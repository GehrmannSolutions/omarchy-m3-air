#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Fay (2026-10-13): lid policy for Omarchy on the MacBook Air M3 (J613).
#
# logind suspends a closed laptop the moment it counts no external display, and
# while the lid is closed it counts again after every event it handles. On this
# Mac a display that changes pipelines (lid closed, a second display arrives and
# the first one moves to the internal pipe) is unplugged for about three seconds,
# so logind suspended in the middle of every such move. GNOME and KDE take the
# lid switch from logind with a "handle-lid-switch" inhibitor and decide
# themselves; this does the same for Omarchy, with the same rule as logind's
# defaults (HandleLidSwitch=suspend, HandleLidSwitchDocked=ignore) plus a grace
# period: lid closed and no external display for FAY_LID_GRACE seconds (default
# 10) -> lock (omarchy-system-lock) and suspend. The unit runs this under
# systemd-inhibit, so if it stops, logind's own lid handling is back at once.
#
# 2026-10-16 (Marius): on the charger a closed lid only locks, it does not
# suspend (bed, sofa: there is always a charger). Pulling the charger while the
# lid stays closed suspends after the same grace period. With an external
# display nothing happens, as before.
#   lid closed, external display          -> nothing
#   lid closed, no external, charger      -> lock (once per closing)
#   lid closed, no external, no charger   -> lock and suspend after the grace
#
# FAY_LID_DRYRUN=1 logs what it would do instead of suspending.
# Journal: journalctl --user -t fay-lid-policy
# Remove: systemctl --user disable --now fay-lid-policy.service
set -uo pipefail

GRACE=${FAY_LID_GRACE:-10}
DRYRUN=${FAY_LID_DRYRUN:-0}

log() { logger -t fay-lid-policy "$*"; }

lid_closed() {
  [[ $(busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
       org.freedesktop.login1.Manager LidClosed 2>/dev/null) == "b true" ]]
}

# Same test as omarchy-hw-external-monitors: any connected connector that is not
# the internal panel. A display waiting for a pipeline reads disconnected.
external_display() {
  local s
  for s in /sys/class/drm/card*-*/status; do
    [[ -e $s ]] || continue
    [[ $s =~ -(eDP|LVDS|DSI)-[^/]+/status$ ]] && continue
    [[ $(<"$s") == connected ]] && return 0
  done
  return 1
}

suspends() { cat /sys/power/suspend_stats/success 2>/dev/null || echo 0; }

# The SMC's AC input (a USB-C charger or a display that powers the Mac).
on_charger() {
  local s
  for s in /sys/class/power_supply/*/; do
    [[ $(<"$s/type") == Mains ]] 2>/dev/null || continue
    [[ $(<"$s/online") == 1 ]] 2>/dev/null && return 0
  done
  return 1
}

mode=""; [[ $DRYRUN != 0 ]] && mode=" (dry run)"
log "started: lid closed + no external display for ${GRACE}s -> lock; and suspend unless on the charger$mode"
since=       # lid closed without an external display since (seconds)
locked=      # locked for this closing already (on the charger)
while sleep 1; do
  if lid_closed && ! external_display; then
    now=$(date +%s)
    if [[ -z $since ]]; then
      since=$now
      if on_charger; then
        log "lid closed, no external display, on the charger: locking in ${GRACE}s, no suspend"
      else
        log "lid closed, no external display: suspending in ${GRACE}s unless one comes back"
      fi
    fi
    (( now - since >= GRACE )) || continue
    if on_charger; then
      if [[ -z $locked ]]; then
        if [[ $DRYRUN != 0 ]]; then
          log "dry run: would lock now (on the charger, no suspend)"
        else
          log "on the charger: locking, not suspending"
          omarchy-system-lock >/dev/null 2>&1 || true
        fi
        locked=1
      fi
      continue
    fi
    # No charger (never had one, or it was pulled while closed): the grace
    # counts from the moment the charger went.
    if [[ -n $locked ]]; then
      log "charger removed with the lid closed: suspending in ${GRACE}s unless it comes back"
      locked=
      since=$now
      continue
    fi
    if [[ $DRYRUN != 0 ]]; then
      log "dry run: would lock and suspend now"
      since=
      sleep 30
      continue
    fi
    log "locking and suspending"
    before=$(suspends)
    omarchy-system-lock >/dev/null 2>&1 || true
    systemctl suspend || log "systemctl suspend failed"
    # Wait for the resume (or give up after 60 s) before judging again.
    for _ in $(seq 60); do
      sleep 1
      [[ $(suspends) != "$before" ]] && break
    done
    since=
    locked=
  elif [[ -n $since ]]; then
    lid_closed && log "external display back: not suspending" || log "lid open: not suspending"
    since=
    locked=
  fi
done
