# Fay (2026-10-13, 2026-10-15): desktop hint when a second external display has to wait.
# The M3 MacBook Air drives one external display at a time with the lid open. A
# second one stays dark and turns on by itself when the first one is unplugged.
# With the lid-closed set (kernel/patches-clamshell/ + the fay-lid-policy user
# service) it also turns on when the lid closes (the internal pipe then drives one
# of them). Kernel lines (appledrm):
#   integration/aurora since #114 was merged (2026-10-15), with or without the
#   lid-closed set: "display on X waits for a free external display pipeline
#   (...); it lights up on its own when one of those displays is unplugged"
#   our earlier lid-closed set: "... waits for an external display pipeline:
#   ...; unplug that one and this one takes over"
#   the v2 series / #114 before the merge: "... waits for an external display
#   pipeline ... then plug this one in again" (it takes over by itself as well)
# Older kernels only log the USB-C controller's -EBUSY. Texts in English
# (2026-10-13, Marius).
# Runs as the user service fay-display-busy-notify.service.
set -uo pipefail

last=0
journalctl -k -f -n 0 -o cat | while IFS= read -r line; do
  case $line in
    *"display on "*" waits for "*"external display pipeline"*)
      port=${line#*display on }
      port=${port%% waits*}
      if [[ $line == *"takes over"* ]] || systemctl --user -q is-active fay-lid-policy.service; then
        # the lid-closed set: with the lid closed the internal pipe drives a second display
        hint="With the lid open, this Mac drives one external display at a time. This one turns on when you close the lid (then both work) or when you unplug the other one."
      else
        hint="This Mac drives one external display at a time. This one turns on when you unplug the other one."
      fi
      ;;
    *"sn201202x"*"failed to configure Type-C connection: -16"*)
      port=""
      hint="This Mac drives one external display at a time. To switch, unplug the other one, then plug this one in again."
      ;;
    *) continue ;;
  esac
  # the kernel line and the controller's -EBUSY come together: one hint per plug
  now=$(date +%s)
  (( now - last < 20 )) && continue
  last=$now
  omarchy-notification-send -g 󰍹 -u normal \
    "External display waiting" \
    "${port:+$port: }$hint" \
    >/dev/null 2>&1 || true
done
