+static void fay_log_ack(struct apple_dcp *dcp, enum dcp_context_id context)
+{
+	struct dcp_channel *ch = dcp_get_channel(dcp, context);
+	struct fay_cb_frame *f;
+	const void *out;
+	u32 out_n;
+	u8 depth;
