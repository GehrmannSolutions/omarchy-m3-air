+/*
+ * fay: DART fault instrumentation (debug only, no functional change).
+ * Log every IOMFB callback after its handler ran and before it is acked:
+ * context, tag, header lengths, mailbox offset, ktime_get_ns() and the first
+ * 64 bytes of 'in' and 'out'. Greppable prefix "fay-cb:".
+ *   fay_cb_log=0  off
+ *   fay_cb_log=1  every callback (the test script loads the module with this)
+ *   fay_cb_log=2  every callback except the per-frame D589/D591 swap
+ *                 callbacks (default, so a normal desktop boot of this
+ *                 module does not log two lines per frame)
+ * sync=1: acked right after the handler, 'out' is final.
+ * sync=0: handler defers the ack, 'out' is not final yet; the real reply is
+ *         logged as a "fay-cb-ack:" line when the deferred dcp_ack() is sent.
+ * sync=-1: no handler for this tag, the callback is not acked (unchanged).
+ */
+static int fay_cb_log = 2;
+module_param(fay_cb_log, int, 0644);
+MODULE_PARM_DESC(fay_cb_log,
+		 "fay debug: log IOMFB callbacks with in/out hex dumps (0=off, 1=all, 2=all but D589/D591 (default))");
+
+static bool fay_cb_log_tag(int tag)
+{
+	int mode = READ_ONCE(fay_cb_log);
+
+	if (!mode)
+		return false;
+	if (mode == 2 && (tag == 589 || tag == 591))
+		return false;
+	return true;
+}
+
+#define FAY_CB_DUMP_MAX 64
+
+/* Number of bytes of @p to dump: at most FAY_CB_DUMP_MAX, never past shmem. */
+static u32 fay_cb_dump_len(struct apple_dcp *dcp, const void *p, u32 len)
+{
+	const u8 *start = dcp->shmem;
+	const u8 *end = start + DCP_SHMEM_SIZE;
+	const u8 *q = p;
+
+	if (!start || !q || q < start || q >= end)
+		return 0;
+
+	return min3(len, (u32)FAY_CB_DUMP_MAX, (u32)(end - q));
+}
+
+static void fay_log_cb(struct apple_dcp *dcp, enum dcp_context_id context,
+		       const struct dcp_packet_header *hdr, int tag, u8 depth,
+		       const void *in, const void *out, u32 length, u16 offset,
+		       int sync)
+{
+	char name[12];
+	u32 in_n, out_n;
+	u64 now = ktime_get_ns();
+
+	/*
+	 * Remember the frame (also when logging is off, so that no stale
+	 * frame is reported later): a deferred ack logs the final reply.
+	 */
+	if (sync >= 0 && context < DCP_NUM_CONTEXTS &&
+	    depth < DCP_MAX_CALL_DEPTH) {
+		struct fay_cb_frame *f = &dcp->fay.cb_frames[context][depth];
