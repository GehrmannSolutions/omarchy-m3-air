+	if (!fay_cb_log_tag(tag))
+		return;
+
+	if (tag >= 0)
+		snprintf(name, sizeof(name), "D%03d", tag);
+	else
+		snprintf(name, sizeof(name), "?%02x%02x%02x%02x",
+			 (u8)hdr->tag[3], (u8)hdr->tag[2], (u8)hdr->tag[1],
+			 (u8)hdr->tag[0]);
+
+	in_n = fay_cb_dump_len(dcp, in, hdr->in_len);
+	out_n = fay_cb_dump_len(dcp, out, hdr->out_len);
