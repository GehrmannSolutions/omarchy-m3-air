+		 "fay-cb: ctx=%u %s in_len=%u out_len=%u len=%u off=0x%x shm=0x%lx depth=%u t=%llu sync=%d in[%u]=%*phN out[%u]=%*phN\n",
+		 context, name, hdr->in_len, hdr->out_len, length, offset,
+		 (unsigned long)((const u8 *)hdr - (const u8 *)dcp->shmem),
+		 depth, now, sync, in_n, (int)in_n, in, out_n, (int)out_n, out);
