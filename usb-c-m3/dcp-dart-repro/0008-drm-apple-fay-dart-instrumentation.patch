+		 "fay-cb-ack: ctx=%u D%03d depth=%u out_len=%u t=%llu out[%u]=%*phN\n",
+		 context, f->tag, depth, f->out_len, ktime_get_ns(), out_n,
+		 (int)out_n, out);
