  * with fay_bw_relay=1, forward the dashboard word (bw-scratch offset) to the
  * real pmgr register after the firmware has finished powering down.
  */
+/*
+ * fay patch 0017: read-only dump of dart-dcp's APF block (DAPF at 0x28d310000,
+ * from the ADT /defaults pmap-io-ranges; no ADT node declares it) once, at the
+ * first debugfs sweep while the DCP is up. Slices: 0x40 stride.
+ */
+bool fay_apf_dump;
+module_param(fay_apf_dump, bool, 0444);
+MODULE_PARM_DESC(fay_apf_dump, "fay debug: dump the dart-dcp APF block once (test only)");
+
+static void fay_apf_dump_once(struct apple_dcp *dcp)
+{
+	static bool done;
+	void __iomem *apf;
+	unsigned int i;
+
+	if (!fay_apf_dump || done)
+		return;
+	done = true;
+	apf = ioremap(0x28d310000, 0x4000);
+	if (!apf) {
+		dev_err(dcp->dev, "fay-apf: ioremap failed\n");
+		return;
+	}
+	for (i = 0; i < 16; i++) {
+		void __iomem *sl = apf + i * 0x40;
+
+		dev_info(dcp->dev,
+			 "fay-apf: slice %2u ctrl %#010x r4 %#010x start %#010x%08x end %#010x%08x r20 %#010x\n",
+			 i, readl(sl), readl(sl + 4), readl(sl + 0xc), readl(sl + 8),
+			 readl(sl + 0x14), readl(sl + 0x10), readl(sl + 0x20));
+	}
+	iounmap(apf);
+}
+
