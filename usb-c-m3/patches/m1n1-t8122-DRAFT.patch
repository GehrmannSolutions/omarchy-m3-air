+/*
+ * fay: hand the tail of m1n1's console ring buffer to the OS as
+ * /chosen/fay,m1n1-log, so DT preparation failures (e.g. dcpext carveouts)
+ * can be read on machines without a serial console. Debug aid, not upstream.
+ */
+extern char con_buf[];
+extern size_t con_wp;
+#define FAY_M1N1_LOG_MAX 4096
+
+static void dt_set_fay_m1n1_log(void)
+{
+    static char log[FAY_M1N1_LOG_MAX + 1];
+    const size_t ring = 8192; /* CONSOLE_BUFFER_SIZE in iodev.c */
+    size_t len = min(con_wp, (size_t)FAY_M1N1_LOG_MAX);
+    size_t start = con_wp - len;
+
+    for (size_t i = 0; i < len; i++) {
+        char c = con_buf[(start + i) % ring];
+        log[i] = c ? c : ' ';
+    }
+    log[len] = '\0';
+
+    int chosen = fdt_path_offset(dt, "/chosen");
+    if (chosen < 0 || fdt_setprop_string(dt, chosen, "fay,m1n1-log", log) < 0)
+        printf("FDT: could not set fay,m1n1-log\n");
+}
+
 int kboot_prepare_dt(void *fdt)
 {
     if (dt) {
@@ -2847,6 +2905,8 @@ int kboot_prepare_dt(void *fdt)
     if (dt_set_memory())
         return -1;
 
+    dt_set_fay_m1n1_log();
+
     if (fdt_pack(dt))
         bail("FDT: fdt_pack() failed\n");
 
