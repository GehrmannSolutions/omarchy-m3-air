 /// J613/J615 have no SoC die temperature zone yet, so there is no thermal feedback above it.
 pub(crate) const PSTATE_CAP_MAX: u32 = 5;
 
+/// The DPE leakage block macOS 26 writes on a 10-core J613 (satchlj, omacom/linux-aurora#26,
+/// 2026-10-11): 20 integer words, written to HwDataA +0x418c..+0x41dc and, with
+/// [`DpeLeak::HwDataAAndP1`], to the power-controller block's mirror at P1 +0x15c..+0x1ac.
+/// They are u32 values, not float bit patterns.
+pub(crate) const DPE_LEAK_WORDS: [u32; 20] = [
+    1, 500, 5, //
+    12500, 12500, 12500, 12500, 12500, //
+    3000, 3000, 3000, //
+    12500, 12500, 12500, 12500, 12500, 12500, 12500, 12500, //
+    1,
+];
+/// Where the block starts in HwDataA and in the power-controller block (P1).
+pub(crate) const DPE_LEAK_HWDATA_A: usize = 0x418c;
+pub(crate) const DPE_LEAK_P1: usize = 0x15c;
+
+/// What `asahi.t8122_dpe_leak` writes.
+#[derive(Copy, Clone, Debug, PartialEq, Eq)]
+pub(crate) enum DpeLeak {
+    /// 0, the default: nothing; the InitData is the same as without the parameter.
+    Off,
+    /// 1: [`DPE_LEAK_WORDS`] at HwDataA +0x418c.
+    HwDataA,
+    /// 2: the same, and at P1 +0x15c.
+    HwDataAAndP1,
+}
+
+impl DpeLeak {
+    /// The parameter value, for logs.
+    pub(crate) fn value(self) -> u32 {
+        match self {
+            DpeLeak::Off => 0,
+            DpeLeak::HwDataA => 1,
+            DpeLeak::HwDataAAndP1 => 2,
+        }
+    }
+}
