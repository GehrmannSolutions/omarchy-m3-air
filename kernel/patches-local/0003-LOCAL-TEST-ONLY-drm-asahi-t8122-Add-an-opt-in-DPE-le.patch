+/// Write the DPE leakage block (`t8122_knobs::DPE_LEAK_WORDS`, little-endian u32) at `at` in
+/// `image`, and say when it replaces words that were not 0 (on T8122 14.8.3 they all are).
+fn write_dpe_leak(dev: &device::Device, image: &mut [u8], at: usize, what: &str) -> Result {
+    let mut replaced = 0;
+    for (i, word) in knobs::DPE_LEAK_WORDS.iter().enumerate() {
+        let offset = at + 4 * i;
+        if read_u32(image, offset)? != 0 {
+            replaced += 1;
+        }
+        write(image, offset, &word.to_le_bytes())?;
+    }
+    if replaced != 0 {
+        dev_warn!(dev, "M3: DPE leakage block replaced {} nonzero {} words\n", replaced, what);
+    }
+    Ok(())
+}
+
 /// A zeroed image of owner `index`.
 fn zeroed(index: usize) -> Result<KVVec<u8>> {
     let size = storage::allocation(index).map_err(|_| EINVAL)?.size;
@@ -888,6 +906,12 @@ fn build_images(
     for &(at, value) in soc.hwdata_words {
         write(&mut hwdata, at, &value.to_le_bytes())?;
     }
+    // The T8122 start experiment's DPE leakage block (`asahi.t8122_dpe_leak`), over everything
+    // above. Off by default, and then nothing is written.
+    let dpe_leak = experiment.map_or(DpeLeak::Off, |e| e.dpe_leak());
+    if dpe_leak != DpeLeak::Off {
+        write_dpe_leak(dev, &mut hwdata, HWDATA_A + knobs::DPE_LEAK_HWDATA_A, "HwDataA")?;
+    }
     // On T8122, log and require the two HwDataB words the firmware's power management depends
     // on: it powers the GPU cores up for a job only when +0xa38 and +0xa40 are both nonzero.
     if core::ptr::eq(soc, &crate::m3_soc::T8122) {
@@ -935,6 +959,23 @@ fn build_images(
 
     let mut power = zeroed(GLOBALS_POWER)?;
     write(&mut power, 0, initdata::raw_bytes(&*c.power_ctl_block))?;
+    if dpe_leak == DpeLeak::HwDataAAndP1 {
+        write_dpe_leak(dev, &mut power, knobs::DPE_LEAK_P1, "P1")?;
+    }
+    if dpe_leak != DpeLeak::Off {
+        let mirror = match dpe_leak {
+            DpeLeak::HwDataAAndP1 => ", P1 mirror +0x15c",
+            _ => "",
+        };
+        dev_warn!(
+            dev,
+            "M3: DPE leakage block set (HwDataA+{:#x}, {} words{}) (asahi.t8122_dpe_leak={})\n",
+            knobs::DPE_LEAK_HWDATA_A,
+            knobs::DPE_LEAK_WORDS.len(),
+            mirror,
+            dpe_leak.value()
+        );
+    }
     images[GLOBALS_POWER] = Some(power);
 
     let mut status = zeroed(STATUS)?;
