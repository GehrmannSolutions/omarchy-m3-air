+			jiffies_to_msecs(timeout - ret));
 	}
 
-	dev_dbg(dcp->dev, "dcp_dptx_connect: waited %d ms for link\n",
-		jiffies_to_msecs(timeout - ret));
-
 	usleep_range(5, 10);
 	if (!dcp_connect_session_valid_locked(dcp, session, cable, recovery)) {
 		ret = -ESTALE;
 		goto out_unlock;
 	}
 
-	if (dcp->connector_type == DRM_MODE_CONNECTOR_DisplayPort) {
+	if (dcp->connector_type == DRM_MODE_CONNECTOR_DisplayPort || late_hpd) {
 		ret = dptxport_set_hpd(dcp->dptxport[port].service, true);
-		if (ret && dcp->external)
+		if (ret && late_hpd)
+			dev_err(dcp->dev,
+				"dcp_dptx_connect: failed to assert HPD after the link wait: %d\n",
+				ret);
+		if (ret && (dcp->external || late_hpd))
 			goto out_disconnect;
 	}
 	if (!dcp_connect_session_valid_locked(dcp, session, cable, recovery)) {
@@ -2035,6 +2049,49 @@ static bool dcp_show_notch(struct apple_dcp *dcp)
 	return show_notch || t6030_show_notch;
 }
 
+/*
+ * T8122 dcpext (DCP_FIRMWARE_V_14_7_TEMPLATE): if the PMP runs, the display
+ * gate added its DISPEXT request and pointed the dcpext at it
+ * (apple,pmp-report). As on T6030, run the processor only once the PMP has
+ * acknowledged that request: the running PMP owns the SoC power and
+ * performance states and treats a block whose request it has not taken as
+ * idle. The internal display started the PMP long before this, so the wait
+ * is short; it is bounded, and without an acknowledgement the processor is
+ * started anyway (as before the request existed), with a warning.
+ */
+#define DCP_EXT_PMP_TIMEOUT_MS	3000
+
+static void dcp_ext_wait_pmp(struct apple_dcp *dcp)
+{
+	struct device_node *entry;
+	unsigned long deadline;
+	int ret;
+
+	if (dcp->fw_compat != DCP_FIRMWARE_V_14_7_TEMPLATE)
+		return;
+	entry = of_parse_phandle(dcp->dev->of_node, "apple,pmp-report", 0);
+	if (!entry) {
+		dev_info(dcp->dev, "no PMP DISPEXT request; starting without one\n");
+		return;
+	}
+	deadline = jiffies + msecs_to_jiffies(DCP_EXT_PMP_TIMEOUT_MS);
+	for (;;) {
+		ret = apple_pmp_report_wait_ready(entry,
+						  msecs_to_jiffies(DCP_EXT_PMP_TIMEOUT_MS));
+		/* -EIO: the PMP runs, but has not acknowledged the request yet. */
+		if (ret != -EIO || time_after(jiffies, deadline))
+			break;
+		msleep(20);
+	}
+	of_node_put(entry);
+	if (ret)
+		dev_warn(dcp->dev,
+			 "the PMP has not acknowledged the DISPEXT request (%d); starting anyway\n",
+			 ret);
+	else
+		dev_info(dcp->dev, "PMP acknowledged the DISPEXT request\n");
+}
+
 static int dcp_comp_bind_pipe(struct device *dev, struct device *main, void *data)
 {
 	struct device_node *panel_np;
@@ -2150,6 +2207,8 @@ static int dcp_comp_bind_pipe(struct device *dev, struct device *main, void *dat
 	dcp->swapped_out_fbs =
 		(struct list_head)LIST_HEAD_INIT(dcp->swapped_out_fbs);
 
+	dcp_ext_wait_pmp(dcp);
+
 	cpu_ctrl =
 		readl_relaxed(dcp->coproc_reg + APPLE_DCP_COPROC_CPU_CONTROL);
 	writel_relaxed(cpu_ctrl | APPLE_DCP_COPROC_CPU_CONTROL_RUN,
diff --git a/drivers/gpu/drm/apple/dptxep.c b/drivers/gpu/drm/apple/dptxep.c
index b11e86604..2fc97c208 100644
--- a/drivers/gpu/drm/apple/dptxep.c
+++ b/drivers/gpu/drm/apple/dptxep.c
@@ -629,7 +629,8 @@ static int dptxport_call_get_supports_hpd(struct apple_epic_service *service,
 	 * DEVICE_NOT_STARTED (~5.5s). Advertise HPD so firmware uses
 	 * that path instead of waiting for a PHY start.
 	 */
-	reply->supported = cpu_to_le32(dcp_is_typec_output(dcp) ? 1 : 0);
+	reply->supported = cpu_to_le32(dcp_is_typec_output(dcp) &&
+				       !dcp_ext_dptx_607(dcp) ? 1 : 0);
 	dev_info(dcp->dev, "DPTXPort: GET_SUPPORTS_HPD %u usb4=%d\n",
 		 le32_to_cpu(reply->supported), dcp_is_usb4_output(dcp));
 	return 0;
@@ -816,11 +817,18 @@ static int dptxport_call(struct apple_epic_service *service, u32 idx,
 			 service->ep->dcp->dptx_phy);
 		memcpy(reply, data, min(reply_size, data_size));
 		return 0;
-	case DPTX_APCALL_SET_TILED_DISPLAY_HINTS:
+	case DPTX_APCALL_SET_TILED_DISPLAY_HINTS: {
+		int ret;
+
 		memcpy(reply, data, min(reply_size, data_size));
-		return dptxport_call_set_tiled_display_hint(service, data,
-							    data_size, reply,
-							    reply_size);
+		ret = dptxport_call_set_tiled_display_hint(service, data,
+							   data_size, reply,
+							   reply_size);
+		/* The T8122 dcpext gets 0, as from AsahiLinux/linux#607. */
+		if (!ret && reply_size >= 4 && dcp_ext_dptx_607(service->ep->dcp))
+			memset(reply, 0, 4);
+		return ret;
+	}
 	case DPTX_APCALL_GET_DRIVE_SETTINGS:
 		return dptxport_call_get_drive_settings(service, data, data_size,
 							reply, reply_size);
diff --git a/drivers/gpu/drm/apple/epic/dpavservep.c b/drivers/gpu/drm/apple/epic/dpavservep.c
index 243fbdfe2..fac08e53d 100644
--- a/drivers/gpu/drm/apple/epic/dpavservep.c
+++ b/drivers/gpu/drm/apple/epic/dpavservep.c
@@ -214,8 +214,14 @@ const struct drm_edid *dcpavserv_copy_edid(struct apple_dcp *dcp)
 	/*
 	 * The 14.7 firmware of an external processor answers EDID requests
 	 * once its service has been opened; open each announced instance once.
+	 *
+	 * Only on Aurora's DCPLink session (T6030). The T8122 dcpext, which
+	 * Linux starts and drives through the IOMFB template, reads the EDID
+	 * directly, as in AsahiLinux/linux#607. Its firmware never answers the
+	 * open call and drops the display link instead, about 50 ms after it,
+	 * which brings the display back 4 s later: hotplug in a loop.
 	 */
-	if (dcp_fw_is_14_7(dcp) &&
+	if (dcp->fw_compat == DCP_FIRMWARE_V_14_7 &&
 	    READ_ONCE(dcp->dcpavserv.opened) != service) {
 		int ret = afk_service_call(service, 4, 6, NULL, 0, 32, NULL, 0, 32);
 
