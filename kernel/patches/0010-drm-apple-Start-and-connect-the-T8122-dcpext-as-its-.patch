 drivers/gpu/drm/apple/dcp-internal.h    | 13 ++++
 drivers/gpu/drm/apple/dcp.c             | 91 ++++++++++++++++++++-----
 drivers/gpu/drm/apple/dptxep.c          | 18 +++--
