@@ -624,26 +629,35 @@ static int dcp_dptx_connect_session(struct apple_dcp *dcp, u32 port,
 		ret = -ESTALE;
 		goto out_unlock;
 	}
-	if (!ret) {
+	if (!ret && late_hpd) {
+		/* Without HPD this firmware does not train: assert it now. */
+		dev_dbg(dcp->dev,
+			"dcp_dptx_connect: no link configuration on port %u yet, asserting HPD\n",
