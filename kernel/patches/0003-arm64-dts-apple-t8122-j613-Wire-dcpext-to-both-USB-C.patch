From 3e077b9ff1b7c021af4401df6dff2040665bcc8a Mon Sep 17 00:00:00 2001
From: Marius Gehrmann <marius@gehrmann.solutions>
Date: Tue, 13 Oct 2026 12:12:33 +0200
Subject: [PATCH 03/12] arm64: dts: apple: t8122-j613: Wire dcpext to both
 USB-C ports

Enable the dcpext DARTs and mailbox and the display crossbars of ATC0
and ATC1, add the dcpext alias (the boot loader finds the node through
it), and give dcpext a Type-C display route to each USB-C port in the
typec-routes model:
 - route@0, left-back: ATC0's DP PHY and crossbar as typec0, DPTX
   target 0;
 - route@1, left-front: ATC1's DP PHY and crossbar as typec1, DPTX
   target 1 (the ADT's DFP index of atc1, as in the M1/M2 dcpext
   routes);
both with crossbar state 2 (dispext1,0: one display pipe behind either
ATC's crossbar) and port@3 on the connector. Keep the common power
state of both ATCs on, as for DP alt mode on the M1/M2 laptops.

dcpext and its routes stay disabled here. The boot loader reserves the
dcpext firmware and marks the node; the display gate enables it, its
routes and its display DART once the internal display has been handed
over. A kernel or boot loader without dcpext support therefore sees
nothing new, and the USB-C ports do not wait for a mode switch that
never registers.

dcpext has one DPTX link, so one external display at a time: the
display fabric gives the pipeline to the first port that asks, and a DP
partner on the other port gets USB only. dcpext carries
apple,sync-syslog-ack, the RTKit behaviour its firmware needs
(AsahiLinux/linux#607).

Link: https://github.com/AsahiLinux/linux/pull/607
Assisted-by: Claude:claude-opus-5-5
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017YMqWu7A3VwEYtHaA1TusK
Signed-off-by: Marius Gehrmann <marius@gehrmann.solutions>
---
 arch/arm64/boot/dts/apple/t8122-j613.dts | 123 +++++++++++++++++++++++
 1 file changed, 123 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8122-j613.dts b/arch/arm64/boot/dts/apple/t8122-j613.dts
index a7eb24473..4dda28adc 100644
--- a/arch/arm64/boot/dts/apple/t8122-j613.dts
+++ b/arch/arm64/boot/dts/apple/t8122-j613.dts
@@ -250,3 +250,126 @@ &mesa {
 };
 
 #include "hwmon-laptop.dtsi"
+
+/*
+ * External display on both USB-C ports: left-back (typec0, ATC0) and
+ * left-front (typec1, ATC1). In the J613 ADT dcpext is display-crossbar
+ * ufp1, port 0, which is crossbar state 2 (dispext1,0) in the T602x model,
+ * on either ATC's crossbar. The DPTX target is the ADT's DFP index of the
+ * ATC (atc0 = 0, atc1 = 1), as in the M1/M2 dcpext routes. dcpext has one
+ * DPTX link, so one external display at a time: the display fabric gives
+ * the pipeline to the first port that asks, and the other port keeps USB.
+ *
+ * dcpext itself stays disabled here, like the internal DCP. The boot loader
+ * finds it through the "dcpext" alias, reserves its firmware and marks it
+ * apple,t8122-dcpext-firmware-ready; the kernel's display gate then enables
+ * it, together with typec-routes/route@0, after the internal display was
+ * handed over. The route stays disabled until then, as on T6030: an
+ * available route with no registered mode switch would make the Type-C
+ * port wait for one forever. A kernel or boot loader without dcpext
+ * support therefore sees nothing new.
+ *
+ * The display subsystem's iommus are left alone: the display gate accepts
+ * exactly one entry there (disp0_dart stream 0) before it enables the
+ * internal display, and adds <&dispext0_dart 0> itself when it enables
+ * dcpext, as it does for the T6030 external processors.
+ */
+/ {
+	aliases {
+		dcpext = &dcpext;
+	};
+};
+
+&dispext0_dart {
+	status = "okay";
+};
+
+&dcpext_dart {
+	status = "okay";
+};
+
+&dcpext_mbox {
+	status = "okay";
+};
+
+&atcphy0_xbar {
+	status = "okay";
+};
+
+&atcphy1_xbar {
+	status = "okay";
+};
+
+&dcpext {
+	apple,connector-type = "USB-C";
+	phys = <&atcphy0 PHY_TYPE_DP>, <&atcphy1 PHY_TYPE_DP>;
+	phy-names = "typec0", "typec1";
+	mux-controls = <&atcphy0_xbar 0>, <&atcphy1_xbar 0>;
+	mux-control-names = "typec0", "typec1";
+	apple,typec-mux-indices = <2 2>;
+	apple,typec-dptx-phys = <0 1>;
+	/* RTKit quirks of AsahiLinux/linux#607 (syslog/ioreport acks, kdebug). */
+	apple,sync-syslog-ack;
+
+	typec-routes {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		route@0 {
+			reg = <0>;
+			mode-switch;
+			status = "disabled";
+
+			port {
+				dcpext_typec0: endpoint {
+					remote-endpoint = <&typec0_dcpext>;
+				};
+			};
+		};
+
+		route@1 {
+			reg = <1>;
+			mode-switch;
+			status = "disabled";
+
+			port {
+				dcpext_typec1: endpoint {
+					remote-endpoint = <&typec1_dcpext>;
+				};
+			};
+		};
+	};
+};
+
+&typec0 {
+	ports {
+		port@3 {
+			reg = <3>;
+
+			typec0_dcpext: endpoint {
+				remote-endpoint = <&dcpext_typec0>;
+			};
+		};
+	};
+};
+
+&typec1 {
+	ports {
+		port@3 {
+			reg = <3>;
+
+			typec1_dcpext: endpoint {
+				remote-endpoint = <&dcpext_typec1>;
+			};
+		};
+	};
+};
+
+/* Needs to stay on for DisplayPort alternate mode across suspend, as on T8112. */
+&ps_atc0_common {
+	apple,always-on;
+};
+
+&ps_atc1_common {
+	apple,always-on;
+};
-- 
