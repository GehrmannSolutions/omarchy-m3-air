 drivers/gpu/drm/apple/dcp-internal.h |   9 +-
 drivers/gpu/drm/apple/dcp.c          |  52 +++++++----
 drivers/gpu/drm/apple/iomfb_v14_7.c  | 126 ++++++++++++++++++++++-----
