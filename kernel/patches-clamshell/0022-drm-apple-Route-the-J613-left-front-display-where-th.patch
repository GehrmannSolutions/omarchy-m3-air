 drivers/gpu/drm/apple/apple_drv.c   |   6 +-
 drivers/gpu/drm/apple/dcp-fabric.c  | 123 +++++++++++++++++++++-------
 drivers/gpu/drm/apple/dcp.c         |  78 ++++++++++++++++--
 drivers/gpu/drm/apple/dcp.h         |   1 +
 drivers/gpu/drm/apple/iomfb_v14_7.c |  12 ++-
 5 files changed, 181 insertions(+), 39 deletions(-)

diff --git a/drivers/gpu/drm/apple/apple_drv.c b/drivers/gpu/drm/apple/apple_drv.c
index be0f9b98d..7561ba7c5 100644
--- a/drivers/gpu/drm/apple/apple_drv.c
+++ b/drivers/gpu/drm/apple/apple_drv.c
@@ -98,8 +98,10 @@ apple_connector_detect(struct drm_connector *connector, bool force)
 		return connector_status_connected;
 	if (connector->force == DRM_FORCE_OFF)
 		return connector_status_disconnected;
-	return READ_ONCE(apple_connector->connected) ? connector_status_connected :
-						    connector_status_disconnected;
+	if (!READ_ONCE(apple_connector->connected) ||
+	    dcp_clamshell_hold_connector(apple_connector))
+		return connector_status_disconnected;
+	return connector_status_connected;
 }
 
 static void apple_connector_oob_hotplug(struct drm_connector *connector,
diff --git a/drivers/gpu/drm/apple/dcp-fabric.c b/drivers/gpu/drm/apple/dcp-fabric.c
index 058d35ac7..2be5c1a7f 100644
--- a/drivers/gpu/drm/apple/dcp-fabric.c
+++ b/drivers/gpu/drm/apple/dcp-fabric.c
@@ -817,8 +817,16 @@ static void dcp_fabric_snapshot_port(struct apple_dcp_typec_port *port,
 		pipeline->bound = !!dcp->crtc && !dcp->tb_retiring;
 		pipeline->crtc_index =
 			dcp->crtc ? drm_crtc_index(&dcp->crtc->base) : 0;
-		/* The J613 internal pipe is a hybrid too: its panel is its fixed output. */
-		pipeline->has_fixed = !!dcp->fixed_phy || dcp->clamshell;
+		/*
+		 * The J613 internal pipe is a hybrid too, its panel being its
+		 * fixed output, but not while the lid is closed and the panel
+		 * off: the panel's connector reads disconnected then, and
+		 * aquamarine gives a display on the left-front port the lowest
+		 * free CRTC it can use, the internal pipe's (index 0, below
+		 * dcpext's). Ranked as a plain pipeline, the route follows.
+		 */
+		pipeline->has_fixed = !!dcp->fixed_phy ||
+			(dcp->clamshell && !READ_ONCE(dcp->clamshell_free));
 		pipeline->fixed_busy = dcp_typec_route_busy(route);
 		pipeline->owned = !!dcp->active_typec_route || dcp->tb_retiring;
 		pipeline->tunnel_held = dcp_typec_tunnel_held(dcp);
@@ -1206,14 +1214,19 @@ void dcp_typec_reorder(void)
 
 static int dcp_typec_port_busy(struct apple_dcp_typec_port *port,
 			       struct apple_dcp *dcp);
+static void dcp_typec_clamshell_settle(void);
 
 /*
  * The J613 internal pipe became free for a Type-C display (lid closed, panel
  * off) or is its panel's again (the lid opens). Free: it takes a port left
- * waiting for a pipeline, as any pipeline that is let go of; the ranking puts
- * it after dcpext, as a hybrid. Its panel's again: the display it drives lets
- * go of it (powered off first, as macOS does), and goes to another free
- * pipeline or waits again. Returns whether a display let go.
+ * waiting for a pipeline, as any pipeline that is let go of, ranked before
+ * dcpext while it is free (see dcp_fabric_snapshot_port()); and before a
+ * compositor owns the displays (boot with the lid closed), a display that
+ * took dcpext on the left-front port moves to it, where the compositor will
+ * pair that display (dcp_typec_clamshell_settle()). Its panel's again: the
+ * display it drives lets go of it (powered off first, as macOS does), and
+ * goes to another free pipeline or waits again. Returns whether a display
+ * let go.
  */
 bool dcp_typec_pipeline_changed(struct apple_dcp *dcp)
 {
@@ -1224,6 +1237,7 @@ bool dcp_typec_pipeline_changed(struct apple_dcp *dcp)
 
 	if (!dcp_typec_route_fixed_output_busy(&dcp->typec_routes[0])) {
 		dcp_typec_pipeline_freed();
+		dcp_typec_clamshell_settle();
 		return false;
 	}
 	for (i = 0; i < dcp->nr_typec_routes; i++) {
@@ -1271,6 +1285,43 @@ static int dcp_typec_port_busy(struct apple_dcp_typec_port *port,
 	return -EBUSY;
 }
 
+/*
+ * Move the display on @port from @from (dcpext) to @to, the free J613
+ * internal pipe: an unplug and replug, as any move. Returns whether @from
+ * was let go of.
+ */
+static bool dcp_typec_clamshell_move(struct apple_dcp_typec_port *port,
+				     struct apple_dcp_typec_route *from,
+				     struct apple_dcp_typec_route *to)
+{
+	struct apple_dcp *dcp = from->dcp;
+	int ret;
+
+	lockdep_assert_held(&dcp_typec_fabric_lock);
+	if (port->hpd || dcp->typec_cable_connected ||
+	    (dcp->typec_connector && dcp->typec_connector->connected)) {
+		ret = dcp_dptx_disconnect_oob(to_platform_device(dcp->dev), 0);
+		if (ret)
+			return false;
+	}
+	port->hpd = false;
+	ret = dcp_typec_route_deactivate(from);
+	if (ret)
+		return false;
+	port->owner = NULL;
+	port->applied_valid = false;
+	port->preferred_route = to;
+	/* @from is free now, whether the internal pipe takes over or not */
+	if (dcp_typec_route_activate(to, to->xbar)) {
+		port->busy_noted = false;
+		dcp_typec_port_busy(port, to->dcp);
+		return true;
+	}
+	port->owner = to;
+	dcp_typec_port_attach(port);
+	return true;
+}
+
 /*
  * J613 with the lid closed: a display arriving on @port can only have
  * dcpext, which drives the display on the left-front port, and the internal
@@ -1286,7 +1337,6 @@ static bool dcp_typec_clamshell_make_room(struct apple_dcp_typec_port *port)
 	struct apple_dcp_typec_route *route, *from, *to;
 	struct apple_dcp *dcp;
 	bool reachable;
-	int ret;
 
 	lockdep_assert_held(&dcp_typec_fabric_lock);
 	if (!port->dp_hpd)
@@ -1314,32 +1364,47 @@ static bool dcp_typec_clamshell_make_room(struct apple_dcp_typec_port *port)
 		dcp = from->dcp;
 		dev_info(dcp->dev, "lid closed: the display on %pOF moves to the internal pipe, so that this pipeline can drive the one on %pOF\n",
 			 other->connector_np, port->connector_np);
-		if (other->hpd || dcp->typec_cable_connected ||
-		    (dcp->typec_connector && dcp->typec_connector->connected)) {
-			ret = dcp_dptx_disconnect_oob(to_platform_device(dcp->dev), 0);
-			if (ret)
-				return false;
-		}
-		other->hpd = false;
-		ret = dcp_typec_route_deactivate(from);
-		if (ret)
-			return false;
-		other->owner = NULL;
-		other->applied_valid = false;
-		other->preferred_route = to;
-		/* dcpext is free now, whether the internal pipe takes over or not */
-		if (dcp_typec_route_activate(to, to->xbar)) {
-			other->busy_noted = false;
-			dcp_typec_port_busy(other, to->dcp);
-			return true;
-		}
-		other->owner = to;
-		dcp_typec_port_attach(other);
-		return true;
+		return dcp_typec_clamshell_move(other, from, to);
 	}
 	return false;
 }
 
+/*
+ * Before a compositor owns the displays (boot with the lid closed): a
+ * display on the left-front port that took dcpext before the internal pipe
+ * was free moves to the internal pipe, the CRTC aquamarine will pair it
+ * with (the lowest free one it can use while the panel's connector reads
+ * disconnected). Once a compositor runs it keeps the CRTC it gave the
+ * display, so nothing moves then.
+ */
+static void dcp_typec_clamshell_settle(void)
+{
+	struct apple_dcp_typec_port *port;
+	struct apple_dcp_typec_route *route, *from, *to;
+	struct drm_device *drm;
+
+	lockdep_assert_held(&dcp_typec_fabric_lock);
+	drm = dcp_typec_drm();
+	if (drm && dcp_typec_frozen(drm))
+		return;
+	list_for_each_entry(port, &dcp_typec_ports, link) {
+		from = port->owner;
+		if (!from || from->tunnel || port->secondary_owner ||
+		    from->dcp->clamshell)
+			continue;
+		to = NULL;
+		list_for_each_entry(route, &port->routes, port_link)
+			if (route->dcp->clamshell && !route->tunnel &&
+			    dcp_typec_route_available(route))
+				to = route;
+		if (!to)
+			continue;
+		dev_info(from->dcp->dev, "lid closed, before a compositor started: the display on %pOF moves to the internal pipe, where the compositor will pair it\n",
+			 port->connector_np);
+		dcp_typec_clamshell_move(port, from, to);
+	}
+}
+
 static int dcp_typec_route_set(struct typec_mux_dev *mux,
 			       struct typec_mux_state *state)
 {
diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index b95c75daa..ed645a280 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -1326,12 +1326,14 @@ unsigned long* dcp_get_iomfb_surfaces(struct platform_device *pdev)
  * every panel frame, which then never completes.
  *
  * With the lid closed and the panel and its CRTC off the pipe is free for
- * the display on its Type-C route (dcp->clamshell_free), one that dcpext
- * cannot take (see dcp_typec_pipeline_changed()), and the compositor gives
- * the pipe's one CRTC to that display. As macOS opens the lid, that display
- * lets go of the pipe first, then IOMFB is told; the panel's connector comes
- * back once the compositor switched the CRTC off, or two seconds later, and
- * at once if no display had the pipe.
+ * the display on its Type-C route (dcp->clamshell_free), and ranked before
+ * dcpext then: the compositor gives that display the pipe's one CRTC, the
+ * lowest free one (see dcp_typec_pipeline_changed()). As macOS opens the
+ * lid, that display lets go of the pipe first, then IOMFB is told; the
+ * panel's connector comes back once the compositor switched the CRTC off,
+ * or two seconds later, and at once if no display had the pipe. A display
+ * that goes to dcpext meanwhile reads disconnected until then
+ * (DCP_CLAMSHELL_HOLD_MS), so that the panel has its CRTC back first.
  */
 static DEFINE_MUTEX(dcp_lid_lock);
 static struct apple_dcp *dcp_lid_dcp;	/* dcp_lid_lock; the handler is registered */
@@ -1339,6 +1341,21 @@ static atomic_t dcp_lid_closed = ATOMIC_INIT(-1);	/* -1: no lid switch yet */
 
 #define DCP_CLAMSHELL_PANEL_MS	2000
 
+/*
+ * As the lid opens, a display on the left-front port that leaves the
+ * internal pipe for a free dcpext reads disconnected until the panel's
+ * connector is connected again, for at most this long: aquamarine pairs a
+ * connector that comes up with the lowest free CRTC it can use, and until
+ * the panel's connector is back that is the internal pipe's, which the
+ * panel needs (its only one) and the display is not routed to.
+ */
+#define DCP_CLAMSHELL_HOLD_MS	3000
+
+static unsigned long dcp_clamshell_hold_until;	/* jiffies */
+static struct apple_connector *dcp_clamshell_held;
+static void dcp_clamshell_hold_work_fn(struct work_struct *work);
+static DECLARE_DELAYED_WORK(dcp_clamshell_hold_work, dcp_clamshell_hold_work_fn);
+
 /* The panel's connector reads disconnected until the lid opens. */
 static void dcp_clamshell_panel_away(struct apple_dcp *dcp)
 {
@@ -1364,6 +1381,12 @@ static void dcp_lid_work_fn(struct work_struct *work)
 	dcp = dcp_lid_dcp;
 	if (!dcp || closed < 0)
 		return;
+	if (!closed && READ_ONCE(dcp->clamshell_panel_away)) {
+		WRITE_ONCE(dcp_clamshell_hold_until,
+			   jiffies + msecs_to_jiffies(DCP_CLAMSHELL_HOLD_MS));
+		mod_delayed_work(system_wq, &dcp_clamshell_hold_work,
+				 msecs_to_jiffies(DCP_CLAMSHELL_HOLD_MS));
+	}
 	if (!closed && READ_ONCE(dcp->clamshell_free)) {
 		WRITE_ONCE(dcp->clamshell_free, false);
 		gave_back = dcp_typec_pipeline_changed(dcp);
@@ -1424,6 +1447,47 @@ static void dcp_clamshell_panel_work(struct work_struct *work)
 	WRITE_ONCE(panel->connected, true);
 	dcp_queue_hotplug(panel);
 	dev_info(dcp->dev, "lid open: %s connected again\n", panel->base.name);
+	/* a held display after it, so that it is paired on its own */
+	if (READ_ONCE(dcp_clamshell_held))
+		mod_delayed_work(system_wq, &dcp_clamshell_hold_work,
+				 msecs_to_jiffies(200));
+}
+
+/*
+ * Should @connector, a Type-C connector that has just come up, still read
+ * disconnected (see DCP_CLAMSHELL_HOLD_MS)? Only one the compositor has
+ * not seen connected and that could be paired with the internal pipe's CRTC.
+ */
+bool dcp_clamshell_hold_connector(struct apple_connector *connector)
+{
+	struct apple_dcp *dcp = READ_ONCE(dcp_lid_dcp);
+
+	if (!dcp || !dcp->crtc || connector == dcp->fixed_connector ||
+	    connector->base.status == connector_status_connected ||
+	    !(connector->candidate_crtcs & BIT(drm_crtc_index(&dcp->crtc->base))) ||
+	    atomic_read(&dcp_lid_closed) != 0 ||
+	    !READ_ONCE(dcp->clamshell_panel_away) ||
+	    !time_before(jiffies, READ_ONCE(dcp_clamshell_hold_until)))
+		return false;
+	if (xchg(&dcp_clamshell_held, connector) != connector)
+		dev_info(dcp->dev, "lid open: %s reads disconnected until %s is connected again\n",
+			 connector->base.name,
+			 dcp->fixed_connector ? dcp->fixed_connector->base.name : "the panel");
+	return true;
+}
+
+/* The panel's connector is back, or the hold ran out: report the display. */
+static void dcp_clamshell_hold_work_fn(struct work_struct *work)
+{
+	struct apple_connector *held = xchg(&dcp_clamshell_held, NULL);
+	struct apple_dcp *dcp = READ_ONCE(dcp_lid_dcp);
+
+	if (!held)
+		return;
+	if (dcp && READ_ONCE(dcp->clamshell_panel_away))
+		dev_info(dcp->dev, "lid open: %s connected after %u ms without the panel\n",
+			 held->base.name, DCP_CLAMSHELL_HOLD_MS);
+	dcp_queue_hotplug(held);
 }
 
 static void dcp_lid_event(struct input_handle *handle, unsigned int type,
@@ -1516,6 +1580,8 @@ static void dcp_lid_stop(struct apple_dcp *dcp)
 	}
 	input_unregister_handler(&dcp_lid_handler);
 	cancel_work_sync(&dcp_lid_work);
+	cancel_delayed_work_sync(&dcp_clamshell_hold_work);
+	WRITE_ONCE(dcp_clamshell_held, NULL);
 	atomic_set(&dcp_lid_closed, -1);
 }
 
diff --git a/drivers/gpu/drm/apple/dcp.h b/drivers/gpu/drm/apple/dcp.h
index 2c73c927e..e0f029c66 100644
--- a/drivers/gpu/drm/apple/dcp.h
+++ b/drivers/gpu/drm/apple/dcp.h
@@ -47,6 +47,7 @@ int dcp_get_connector_type(struct platform_device *pdev);
 bool dcp_fw_compat_is_12_x(struct platform_device *pdev);
 bool dcp_fw_compat_is_14_7(struct platform_device *pdev);
 bool dcp_ext_unusable(struct platform_device *pdev);
+bool dcp_clamshell_hold_connector(struct apple_connector *connector);
 unsigned long* dcp_get_iomfb_surfaces(struct platform_device *pdev);
 int dcp_start(struct platform_device *pdev);
 int dcp_wait_ready(struct platform_device *pdev, u64 timeout);
diff --git a/drivers/gpu/drm/apple/iomfb_v14_7.c b/drivers/gpu/drm/apple/iomfb_v14_7.c
index 7bdc70c3b..0b6366608 100644
--- a/drivers/gpu/drm/apple/iomfb_v14_7.c
+++ b/drivers/gpu/drm/apple/iomfb_v14_7.c
@@ -3202,10 +3202,18 @@ void iomfb_v14_7_set_lid(struct apple_dcp *dcp, bool closed)
 			goto out;
 		v14->lid = le32_to_cpu(state);
 	}
-	if (closed)
+	if (closed) {
 		dcp_v14_panel_off_locked(v14);
-	else if (!v14->panel_blank)
+		/*
+		 * A panel CRTC that was never switched on (the lid was closed
+		 * at boot, and the panel's connector has read disconnected
+		 * since) is as blank as one switched off: the pipe is free.
+		 */
+		if (!READ_ONCE(dcp->clamshell_crtc_on))
+			v14->panel_blank = true;
+	} else if (!v14->panel_blank) {
 		dcp_v14_panel_on_locked(v14);
+	}
 out:
 	mutex_unlock(&v14->lock);
 }
