From 3dda554e44582671518cdac5581c7ec85d1f82e7 Mon Sep 17 00:00:00 2001
From: Marius Gehrmann <marius@gehrmann.solutions>
Date: Tue, 13 Oct 2026 20:34:43 +0200
Subject: [PATCH 20/22] drm: apple: Move the left-front display to the internal
 pipe when needed

On J613 with the lid closed, dcpext can drive either USB-C port and the
internal pipe only the left-front one. With a display on the left-front
port already on dcpext, a display arriving on the left-back port waited
for a pipeline although the internal pipe was free: "dcpext first" gave
the front display dcpext when it came, and nothing moved afterwards.

macOS drives the second external display with the internal pipe. Do the
same when it is needed, and only then: when a display arrives on a port
that only a busy pipeline can drive, and the display on that pipeline
sits on a port the free internal pipe can drive, move that display to the
internal pipe (an unplug and replug, as any move: its link goes down
first, which also tells the old CRTC's late power-off to leave the next
display alone), then give the arriving display the pipeline it let go
of. If the internal pipe cannot take the moved display after all, that
display waits, as it would have, and the arriving one is driven.

Assisted-by: Claude:claude-opus-5-5
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017YMqWu7A3VwEYtHaA1TusK
---
 drivers/gpu/drm/apple/dcp-fabric.c | 71 ++++++++++++++++++++++++++++++
 1 file changed, 71 insertions(+)

diff --git a/drivers/gpu/drm/apple/dcp-fabric.c b/drivers/gpu/drm/apple/dcp-fabric.c
index cfd69f4c0..058d35ac7 100644
--- a/drivers/gpu/drm/apple/dcp-fabric.c
+++ b/drivers/gpu/drm/apple/dcp-fabric.c
@@ -1271,6 +1271,75 @@ static int dcp_typec_port_busy(struct apple_dcp_typec_port *port,
 	return -EBUSY;
 }
 
+/*
+ * J613 with the lid closed: a display arriving on @port can only have
+ * dcpext, which drives the display on the left-front port, and the internal
+ * pipe, which only reaches that port, is free. As macOS, which drives the
+ * second external display with the internal pipe, move the left-front
+ * display to the internal pipe (an unplug and replug, as any move), so that
+ * dcpext is free for @port. Only then: nothing moves otherwise. Returns
+ * whether a pipeline @port can have was let go of.
+ */
+static bool dcp_typec_clamshell_make_room(struct apple_dcp_typec_port *port)
+{
+	struct apple_dcp_typec_port *other;
+	struct apple_dcp_typec_route *route, *from, *to;
+	struct apple_dcp *dcp;
+	bool reachable;
+	int ret;
+
+	lockdep_assert_held(&dcp_typec_fabric_lock);
+	if (!port->dp_hpd)
+		return false;
+	list_for_each_entry(other, &dcp_typec_ports, link) {
+		from = other->owner;
+		if (other == port || !from || from->tunnel || other->secondary_owner ||
+		    from->dcp->clamshell)
+			continue;
+		/* @port could have the pipeline @other has... */
+		reachable = false;
+		list_for_each_entry(route, &port->routes, port_link)
+			reachable |= route->dcp == from->dcp && !route->tunnel;
+		if (!reachable)
+			continue;
+		/* ...and @other could have the free internal pipe instead. */
+		to = NULL;
+		list_for_each_entry(route, &other->routes, port_link)
+			if (route->dcp->clamshell && !route->tunnel &&
+			    dcp_typec_route_available(route))
+				to = route;
+		if (!to)
+			continue;
+
+		dcp = from->dcp;
+		dev_info(dcp->dev, "lid closed: the display on %pOF moves to the internal pipe, so that this pipeline can drive the one on %pOF\n",
+			 other->connector_np, port->connector_np);
+		if (other->hpd || dcp->typec_cable_connected ||
+		    (dcp->typec_connector && dcp->typec_connector->connected)) {
+			ret = dcp_dptx_disconnect_oob(to_platform_device(dcp->dev), 0);
+			if (ret)
+				return false;
+		}
+		other->hpd = false;
+		ret = dcp_typec_route_deactivate(from);
+		if (ret)
+			return false;
+		other->owner = NULL;
+		other->applied_valid = false;
+		other->preferred_route = to;
+		/* dcpext is free now, whether the internal pipe takes over or not */
+		if (dcp_typec_route_activate(to, to->xbar)) {
+			other->busy_noted = false;
+			dcp_typec_port_busy(other, to->dcp);
+			return true;
+		}
+		other->owner = to;
+		dcp_typec_port_attach(other);
+		return true;
+	}
+	return false;
+}
+
 static int dcp_typec_route_set(struct typec_mux_dev *mux,
 			       struct typec_mux_state *state)
 {
@@ -1400,6 +1469,8 @@ static int dcp_typec_route_set(struct typec_mux_dev *mux,
 
 	if (!port->owner) {
 		best = dcp_typec_free_route(port);
+		if (!best && dcp_typec_clamshell_make_room(port))
+			best = dcp_typec_free_route(port);
 		if (!best)
 			return dcp_typec_port_busy(port, route->dcp);
 
