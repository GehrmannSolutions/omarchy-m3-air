diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index 4d8a1b44c..cbf563501 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -9,6 +9,7 @@
 #include <linux/delay.h>
 #include <linux/dma-mapping.h>
 #include <linux/gpio/consumer.h>
+#include <linux/input.h>
 #include <linux/iommu.h>
 #include <linux/jiffies.h>
 #include <linux/kconfig.h>
@@ -1311,6 +1312,130 @@ unsigned long* dcp_get_iomfb_surfaces(struct platform_device *pdev)
 	return dcp->iomfb_surfaces;
 }
 
+/*
+ * The lid switch, for the internal pipe that also has a Type-C route
+ * (dcp->clamshell, J613; one per machine). As macOS, the driver tells the
+ * panel's firmware the lid state, and with the lid closed the panel is
+ * powered off with its CRTC (iomfb_v14_7_set_lid()), so that the desktop's
+ * clamshell handling decides when, as on any laptop.
+ */
+static DEFINE_MUTEX(dcp_lid_lock);
+static struct apple_dcp *dcp_lid_dcp;	/* dcp_lid_lock; the handler is registered */
+static atomic_t dcp_lid_closed = ATOMIC_INIT(-1);	/* -1: no lid switch yet */
+
+static void dcp_lid_work_fn(struct work_struct *work)
+{
+	int closed = atomic_read(&dcp_lid_closed);
+
+	guard(mutex)(&dcp_lid_lock);
+	if (dcp_lid_dcp && closed >= 0)
+		iomfb_v14_7_set_lid(dcp_lid_dcp, closed);
+}
+static DECLARE_WORK(dcp_lid_work, dcp_lid_work_fn);
+
+static void dcp_lid_event(struct input_handle *handle, unsigned int type,
+			  unsigned int code, int value)
+{
+	if (type != EV_SW || code != SW_LID)
+		return;
+	atomic_set(&dcp_lid_closed, !!value);
+	schedule_work(&dcp_lid_work);
+}
+
+static int dcp_lid_connect(struct input_handler *handler, struct input_dev *dev,
+			   const struct input_device_id *id)
+{
+	struct input_handle *handle;
+	int ret;
+
+	handle = kzalloc_obj(*handle);
+	if (!handle)
+		return -ENOMEM;
+	handle->dev = dev;
+	handle->handler = handler;
+	handle->name = "appledrm-lid";
+	ret = input_register_handle(handle);
+	if (ret)
+		goto free;
+	ret = input_open_device(handle);
+	if (ret)
+		goto unregister;
+	atomic_set(&dcp_lid_closed, test_bit(SW_LID, dev->sw));
+	pr_info("appledrm: lid switch %s, lid %s\n", dev->name,
+		test_bit(SW_LID, dev->sw) ? "closed" : "open");
+	schedule_work(&dcp_lid_work);
+	return 0;
+
+unregister:
+	input_unregister_handle(handle);
+free:
+	kfree(handle);
+	return ret;
+}
+
+static void dcp_lid_disconnect(struct input_handle *handle)
+{
+	input_close_device(handle);
+	input_unregister_handle(handle);
+	kfree(handle);
+}
+
+static const struct input_device_id dcp_lid_ids[] = {
+	{
+		.flags = INPUT_DEVICE_ID_MATCH_EVBIT | INPUT_DEVICE_ID_MATCH_SWBIT,
+		.evbit = { BIT_MASK(EV_SW) },
+		.swbit = { [BIT_WORD(SW_LID)] = BIT_MASK(SW_LID) },
+	},
+	{}
+};
+
+static struct input_handler dcp_lid_handler = {
+	.event = dcp_lid_event,
+	.connect = dcp_lid_connect,
+	.disconnect = dcp_lid_disconnect,
+	.name = "appledrm-lid",
+	.id_table = dcp_lid_ids,
+};
+
+static void dcp_lid_start(struct apple_dcp *dcp)
+{
+	int ret;
+
+	scoped_guard(mutex, &dcp_lid_lock) {
+		if (dcp_lid_dcp)
+			return;
+		dcp_lid_dcp = dcp;
+	}
+	ret = input_register_handler(&dcp_lid_handler);
+	if (!ret)
+		return;
+	dev_err(dcp->dev, "lid switch not followed: %d\n", ret);
+	scoped_guard(mutex, &dcp_lid_lock)
+		dcp_lid_dcp = NULL;
+}
+
+static void dcp_lid_stop(struct apple_dcp *dcp)
+{
+	scoped_guard(mutex, &dcp_lid_lock) {
+		if (dcp_lid_dcp != dcp)
+			return;
+		dcp_lid_dcp = NULL;
+	}
+	input_unregister_handler(&dcp_lid_handler);
+	cancel_work_sync(&dcp_lid_work);
+	atomic_set(&dcp_lid_closed, -1);
+}
+
+/* After the panel started, which the DRM device does not wait for. */
+static void dcp_clamshell_start(struct work_struct *work)
+{
+	struct apple_dcp *dcp = container_of(work, struct apple_dcp, clamshell_start_work);
+
+	if (iomfb_v14_7_clamshell_start(dcp))
+		return;
+	dcp_lid_start(dcp);
+}
+
 int dcp_start(struct platform_device *pdev)
 {
 	struct apple_dcp *dcp = platform_get_drvdata(pdev);
@@ -1335,6 +1460,8 @@ int dcp_start(struct platform_device *pdev)
 		ret = iomfb_v14_7_start(dcp);
 		if (ret)
 			return ret;
+		if (dcp->clamshell)
+			schedule_work(&dcp->clamshell_start_work);
 		return 0;
 	}
 
@@ -2300,6 +2427,10 @@ static void dcp_comp_unbind(struct device *dev, struct device *main, void *data)
 			disable_delayed_work_sync(&dcp->swap_watchdog_wq);
 			disable_work_sync(&dcp->vblank_wq);
 		}
+		if (dcp->clamshell) {
+			cancel_work_sync(&dcp->clamshell_start_work);
+			dcp_lid_stop(dcp);
+		}
 		iomfb_v14_7_unbind(dcp);
 		return;
 	}
@@ -2703,6 +2834,10 @@ static int dcp_platform_probe_pipe(struct platform_device *pdev)
 			return ret;
 		routes_failed = true;
 	}
+	/* J613: the panel's pipe with a Type-C route the display gate enabled. */
+	dcp->clamshell = dcp_is_v14_panel(dcp) && dcp->nr_typec_routes;
+	if (dcp->clamshell)
+		INIT_WORK(&dcp->clamshell_start_work, dcp_clamshell_start);
 
 	/*
 	 * The manual external path stays out of the panel's DRM device. A
diff --git a/drivers/gpu/drm/apple/iomfb_v14_7.c b/drivers/gpu/drm/apple/iomfb_v14_7.c
index 9593cfbc8..68e5ce34e 100644
--- a/drivers/gpu/drm/apple/iomfb_v14_7.c
+++ b/drivers/gpu/drm/apple/iomfb_v14_7.c
@@ -190,6 +190,16 @@ struct apple_dcp_v14 {
 	struct work_struct stopped_work;
 	bool failed;
 	bool started;
+	/*
+	 * J613 internal pipe with a Type-C route (iomfb_v14_7_clamshell_start()):
+	 * the lid state IOMFB was told (A475: 1 open, 2 closed, 0 not yet), the
+	 * panel's CRTC is off (panel_blank), and the panel was powered off with
+	 * it because the lid is closed (panel_off, A472(0)).
+	 */
+	bool clamshell;
+	u32 lid;
+	bool panel_blank;
+	bool panel_off;
 
 	/*
 	 * An external processor: no panel. Its modes come from the
@@ -883,6 +893,18 @@ static int dcp_v14_callback(void *cookie, u32 tag, const void *input, u32 in_siz
 	}
 
 #define SHAPE(i, o) (in_size == (i) && out_size == (o))
+	/*
+	 * J613: powering the panel off and on with the lid closed sends what an
+	 * external pipe's power changes send (see dcp_v14_external_callback()),
+	 * and D593 with four bytes once after power-on, whose meaning is not
+	 * known. Nothing to do for any of them.
+	 */
+	if (v14->clamshell &&
+	    ((tag == D(2) && SHAPE(0, 0)) || (tag == D(591) && SHAPE(20, 0)) ||
+	     (tag == D(593) && SHAPE(4, 0))))
+		return 0;
+	if (v14->clamshell && tag == D(574) && SHAPE(4, 4))
+		return in[0] > 1 ? -EINVAL : 0;
 	/*
 	 * Backlight correction notification: one signed 32-bit factor, no
 	 * reply payload. The firmware applies it when the colour matrix
@@ -2648,8 +2670,8 @@ static int dcp_v14_set_mode(struct apple_dcp_v14 *v14, u32 color, u32 timing)
 	return ret ?: (le32_to_cpu(status) ? -EIO : 0);
 }
 
-/* A472: the display's power state; its status sits at byte 4 of the reply. */
-static int dcp_v14_set_power(struct apple_dcp_v14 *v14, bool on)
+/* A472: the power state; its status sits at byte 4 of the reply. */
+static int dcp_v14_power_call(struct apple_dcp_v14 *v14, bool on)
 {
 	u8 in[12] = {}, out[8] = {};
 	int ret;
@@ -2658,6 +2680,14 @@ static int dcp_v14_set_power(struct apple_dcp_v14 *v14, bool on)
 	ret = dcp_v14_call(v14, A(472), in, sizeof(in), out, sizeof(out), 0);
 	if (!ret && get_unaligned_le32(out + 4))
 		ret = -EIO;
+	return ret;
+}
+
+/* The attached display's power state (A472). */
+static int dcp_v14_set_power(struct apple_dcp_v14 *v14, bool on)
+{
+	int ret = dcp_v14_power_call(v14, on);
+
 	/* A refused power-down leaves nothing on: the display is gone already. */
 	if (!ret || (!on && !READ_ONCE(v14->failed)))
 		v14->powered = on;
@@ -2835,6 +2865,11 @@ void iomfb_v14_7_flush(struct apple_dcp *dcp, struct drm_crtc *crtc,
 	if (!cs)
 		cs = crtc->state;
 	fb = p && p->visible ? p->fb : NULL;
+	/* No swaps to a panel powered off with the lid closed. */
+	if (!dcp->external && dcp->v14 && READ_ONCE(dcp->v14->panel_off)) {
+		dcp_drm_crtc_vblank(dcp->crtc);
+		return;
+	}
 	/*
 	 * No swaps while an external display is off, unset, unplugged, or
 	 * being described again.
@@ -2856,9 +2891,90 @@ void iomfb_v14_7_flush(struct apple_dcp *dcp, struct drm_crtc *crtc,
 		dcp_v14_cancel_event(dcp);
 }
 
+/*
+ * J613, with the lid closed and the panel's CRTC off: power the panel off
+ * (A472(0)), as macOS does in clamshell mode. Called with the lock held.
+ */
+static void dcp_v14_panel_off_locked(struct apple_dcp_v14 *v14)
+{
+	int ret;
+
+	if (v14->lid != 2 || !v14->panel_blank || v14->panel_off || v14->failed)
+		return;
+	ret = dcp_v14_power_call(v14, false);
+	if (!ret)
+		v14->panel_off = true;
+	dev_info(v14->dev, "lid closed: panel off (A472(0)): %d\n", ret);
+}
+
+/*
+ * J613: the internal pipe has a Type-C route, which only a powered-off panel
+ * leaves free; from now on the lid state counts (iomfb_v14_7_set_lid()).
+ */
+int iomfb_v14_7_clamshell_start(struct apple_dcp *dcp)
+{
+	struct apple_dcp_v14 *v14 = dcp->v14;
+
+	if (!v14 || !v14->started || READ_ONCE(v14->failed))
+		return -ENODEV;
+	mutex_lock(&v14->lock);
+	v14->clamshell = true;
+	mutex_unlock(&v14->lock);
+	return 0;
+}
+
+/*
+ * Tells the panel's IOMFB the lid state, as macOS does (A475, one u32: 1
+ * open, 2 closed; no reply). IOMFB keeps the value and hands it to its DPTX
+ * power controller at every panel power-on, which refuses any other value,
+ * so the real state is sent from the start. With the lid closed, a panel
+ * whose CRTC is off is powered off.
+ */
+void iomfb_v14_7_set_lid(struct apple_dcp *dcp, bool closed)
+{
+	struct apple_dcp_v14 *v14 = dcp->v14;
+	__le32 state = cpu_to_le32(closed ? 2 : 1);
+	int ret;
+
+	if (!v14)
+		return;
+	mutex_lock(&v14->lock);
+	if (!v14->clamshell || v14->failed)
+		goto out;
+	if (v14->lid != le32_to_cpu(state)) {
+		ret = dcp_v14_call(v14, A(475), &state, sizeof(state), NULL, 0, 0);
+		dev_info(dcp->dev, "lid %s: display firmware told (A475(%u)): %d\n",
+			 closed ? "closed" : "open", le32_to_cpu(state), ret);
+		if (ret)
+			goto out;
+		v14->lid = le32_to_cpu(state);
+	}
+	if (closed)
+		dcp_v14_panel_off_locked(v14);
+out:
+	mutex_unlock(&v14->lock);
+}
+
 void iomfb_v14_7_poweron(struct apple_dcp *dcp)
 {
+	struct apple_dcp_v14 *v14 = dcp->v14;
+	int ret;
+
 	/* The panel stays on; the next swap shows the plane again. */
+	if (dcp->external || !v14 || !v14->started)
+		return;
+	mutex_lock(&v14->lock);
+	v14->panel_blank = false;
+	/* Powered off with the lid closed: on again, its colour matrix with it. */
+	if (v14->panel_off && !v14->failed) {
+		ret = dcp_v14_power_call(v14, true);
+		if (!ret) {
+			v14->panel_off = false;
+			v14->ctm_valid = false;
+		}
+		dev_info(dcp->dev, "panel on (A472(1)): %d\n", ret);
+	}
+	mutex_unlock(&v14->lock);
 }
 
 void iomfb_v14_7_poweroff(struct apple_dcp *dcp)
@@ -2876,7 +2992,17 @@ void iomfb_v14_7_poweroff(struct apple_dcp *dcp)
 		dcp_mode_invalidate(&dcp->mode_state);
 		return;
 	}
-	/* Blank to black; the panel and the DCP stay powered. */
-	if (v14 && v14->started)
-		dcp_v14_present(v14, NULL, 0, 0, 0, NULL);
+	/*
+	 * Blank to black; the panel and the DCP stay powered, unless the lid
+	 * is closed (J613): then the panel is powered off.
+	 */
+	if (v14 && v14->started) {
+		if (!READ_ONCE(v14->panel_off))
+			dcp_v14_present(v14, NULL, 0, 0, 0, NULL);
+		mutex_lock(&v14->lock);
+		v14->panel_blank = true;
+		if (v14->clamshell)
+			dcp_v14_panel_off_locked(v14);
+		mutex_unlock(&v14->lock);
+	}
 }
diff --git a/drivers/gpu/drm/apple/iomfb_v14_7.h b/drivers/gpu/drm/apple/iomfb_v14_7.h
