+/*
+ * fay: give a freshly allocated DART page table a pool of firmware-owned
+ * table pages. Must be called before the first map. @used marks pages that
+ * are already in use (e.g. by the locked L1 or iBoot's own tables).
+ */
+void apple_dart_pgtable_set_pool(struct io_pgtable_ops *ops, phys_addr_t pa,
+				 void *va, unsigned int pages,
+				 unsigned long used);
+void apple_dart_pgtable_set_pool(struct io_pgtable_ops *ops, phys_addr_t pa,
+				 void *va, unsigned int pages,
+				 unsigned long used)
+{
+	struct dart_io_pgtable *data = io_pgtable_ops_to_data(ops);
+
+	if (pages > BITS_PER_LONG)
+		pages = BITS_PER_LONG;
+	data->pool_pa = pa;
+	data->pool_pages = pages;
+	data->pool_used = used;
+	data->pool_va = va;
+}
