+	/*
+	 * fay: optional pool for lower-level tables, carved out of the
+	 * firmware page-table region of a locked DART (like macOS does).
+	 */
+	phys_addr_t		pool_pa;
+	void			*pool_va;
+	unsigned int		pool_pages;
+	unsigned long		pool_used;
 };
 
+/* IOPTE accessors */
+#define iopte_deref(pte, d) dart_table_va(d, iopte_to_paddr(pte, d))
+
 typedef u64 dart_iopte;
 
+static bool dart_pool_has_va(struct dart_io_pgtable *data, void *p)
+{
+	size_t sz = data->pool_pages * DART_GRANULE(data);
+
+	return data->pool_va && p >= data->pool_va && p < data->pool_va + sz;
+}
+
+static phys_addr_t dart_table_pa(struct dart_io_pgtable *data, void *p)
+{
+	if (dart_pool_has_va(data, p))
+		return data->pool_pa + (p - data->pool_va);
+	return __pa(p);
+}
+
+static void *dart_table_va(struct dart_io_pgtable *data, phys_addr_t pa)
+{
+	size_t sz = data->pool_pages * DART_GRANULE(data);
+
+	if (data->pool_va && pa >= data->pool_pa && pa < data->pool_pa + sz)
+		return data->pool_va + (pa - data->pool_pa);
+	return __va(pa);
+}
+
+static void *dart_table_alloc(struct dart_io_pgtable *data, gfp_t gfp,
+			      size_t sz)
+{
+	unsigned int i;
+
+	if (data->pool_va && sz == DART_GRANULE(data)) {
+		for (i = 0; i < data->pool_pages; i++) {
+			void *p;
+
+			if (test_and_set_bit(i, &data->pool_used))
+				continue;
+			p = data->pool_va + i * sz;
+			memset(p, 0, sz);
+			pr_info("fay-pool: table page %u (pa %pa) allocated\n",
+				i, &(phys_addr_t){ data->pool_pa + i * sz });
+			return p;
+		}
+		pr_warn_once("fay-pool: table pool exhausted, using normal memory\n");
+	}
+	return iommu_alloc_pages_sz(gfp, sz);
+}
+
+static void dart_table_free(struct dart_io_pgtable *data, void *p)
+{
+	if (dart_pool_has_va(data, p)) {
+		clear_bit((p - data->pool_va) / DART_GRANULE(data),
+			  &data->pool_used);
+		return;
+	}
+	iommu_free_pages(p);
+}
