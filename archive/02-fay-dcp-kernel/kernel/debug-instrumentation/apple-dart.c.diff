+/*
+ * fay test: allocate the lower page tables of one locked DART from its
+ * firmware page-table carveout (pt-region), as macOS does. Selected on the
+ * kernel command line, e.g.
+ *   apple_dart.fay_pool_dev=28d30c000.iommu apple_dart.fay_pool_pa=0x103ffec4000
+ *   apple_dart.fay_pool_size=0x40000
+ * Without these parameters nothing changes.
+ */
+static char *fay_pool_dev;
+module_param(fay_pool_dev, charp, 0444);
+static unsigned long fay_pool_pa;
+module_param(fay_pool_pa, ulong, 0444);
+static unsigned long fay_pool_size;
+module_param(fay_pool_size, ulong, 0444);
+
+void apple_dart_pgtable_set_pool(struct io_pgtable_ops *ops, phys_addr_t pa,
+				 void *va, unsigned int pages,
+				 unsigned long used);
+
+#define FAY_DART2_PADDR_MASK	GENMASK_ULL(37, 10)
+#define FAY_DART2_PADDR_SHIFT	4
+
+static void *fay_pool_va;
+
+/* Kernel VA of a page-table PA, without sleeping (usable in the IRQ). */
+static u64 *fay_table_va(phys_addr_t pa)
+{
+	if (fay_pool_va && pa >= fay_pool_pa && pa < fay_pool_pa + fay_pool_size)
+		return fay_pool_va + (pa - fay_pool_pa);
+	if (memblock_is_map_memory(pa))
+		return __va(pa);
+	return NULL;
+}
+
+/*
+ * fay: dump what the DART hardware itself holds for one stream (registers)
+ * and walk the tables from the TTBR the hardware has, for @dva. Read only.
+ */
+static void apple_dart_fay_dump_sid(struct apple_dart *dart, int sid, u64 dva,
+				    const char *why)
+{
+	u64 *l1, *l2, l1e = 0, pte = 0;
+	phys_addr_t l1_pa, l2_pa = 0;
+	u32 ttbr, l1i, l2i;
+	int i;
+
+	if (dart->hw->type != DART_T8110)
+		return;
+
+	dev_info(dart->dev,
+		 "fay-regs: [%s] sid %d tcr %#x enable %#x disable %#x protect %#x/%#x/%#x err %#x addr %#x:%#x errstreams %#x tlbcmd %#x\n",
+		 why, sid, readl(dart->regs + DART_TCR(dart, sid)),
+		 readl(dart->regs + DART_T8110_ENABLE_STREAMS),
+		 readl(dart->regs + DART_T8110_DISABLE_STREAMS),
+		 readl(dart->regs + DART_T8110_PROTECT),
+		 readl(dart->regs + DART_T8110_UNPROTECT),
+		 readl(dart->regs + DART_T8110_PROTECT_LOCK),
+		 readl(dart->regs + DART_T8110_ERROR),
+		 readl(dart->regs + DART_T8110_ERROR_ADDR_HI),
+		 readl(dart->regs + DART_T8110_ERROR_ADDR_LO),
+		 readl(dart->regs + DART_T8110_ERROR_STREAMS),
+		 readl(dart->regs + DART_T8110_TLB_CMD));
+	for (i = 0; i < dart->hw->ttbr_count; i++)
+		dev_info(dart->dev, "fay-regs: [%s] sid %d ttbr[%d] %#x\n", why,
+			 sid, i, readl(dart->regs + DART_TTBR(dart, sid, i)));
+	{
+		/* patch 0012: params/TLB, errors, protect/tunables, hwrev2 regions */
+		static const u32 fay_ranges[][2] = {
+			{ 0x000, 0x0b0 }, { 0x100, 0x200 }, { 0x200, 0x240 },
+			{ 0x300, 0x360 }, { 0x400, 0x420 },
+		};
+		int r;
+
+		for (r = 0; r < ARRAY_SIZE(fay_ranges); r++)
+			for (i = fay_ranges[r][0]; i < fay_ranges[r][1]; i += 0x10)
+				dev_info(dart->dev, "fay-regs: [%s] +%#05x %08x %08x %08x %08x\n",
+					 why, i, readl(dart->regs + i),
+					 readl(dart->regs + i + 4),
+					 readl(dart->regs + i + 8),
+					 readl(dart->regs + i + 12));
+	}
+
+	/* software walk from the hardware TTBR[0] (2-level, 16K granule) */
+	ttbr = readl(dart->regs + DART_TTBR(dart, sid, 0));
+	if (!(ttbr & dart->hw->ttbr_valid)) {
+		dev_info(dart->dev, "fay-regs: [%s] sid %d ttbr[0] not valid\n", why, sid);
+		return;
+	}
+	ttbr &= ~dart->hw->ttbr_valid;
+	if (dart->hw->ttbr_addr_field_shift)
+		ttbr >>= dart->hw->ttbr_addr_field_shift;
+	l1_pa = ((phys_addr_t)ttbr) << dart->hw->ttbr_shift;
+	l1i = (dva >> 25) & 0x7ff;
+	l2i = (dva >> 14) & 0x7ff;
+	l1 = fay_table_va(l1_pa);
+	if (l1) {
+		l1e = READ_ONCE(l1[l1i]);
+		if (l1e & 1) {
+			l2_pa = (l1e & FAY_DART2_PADDR_MASK) << FAY_DART2_PADDR_SHIFT;
+			l2 = fay_table_va(l2_pa);
+			if (l2)
+				pte = READ_ONCE(l2[l2i]);
+		}
+	}
+	dev_info(dart->dev,
+		 "fay-regs: [%s] walk dva %#llx: L1 pa %pa%s L1[%#x]=%#llx L2 pa %pa L2[%#x]=%#llx\n",
+		 why, dva, &l1_pa, l1 ? "" : " (unmapped)", l1i, l1e, &l2_pa, l2i,
+		 pte);
+}
+
+/* Exported for appledrm's fay sweep: dump the DART state of @master. */
+void apple_dart_fay_dump(struct device *master, u64 dva, const char *why);
+void apple_dart_fay_dump(struct device *master, u64 dva, const char *why)
+{
+	struct apple_dart_master_cfg *cfg = dev_iommu_priv_get(master);
+	struct apple_dart *dart;
+	int sid;
+
+	if (!cfg || !cfg->stream_maps[0].dart)
+		return;
+	dart = cfg->stream_maps[0].dart;
+	for_each_set_bit(sid, cfg->stream_maps[0].sidmap, dart->num_streams)
+		apple_dart_fay_dump_sid(dart, sid, dva, why);
+}
+EXPORT_SYMBOL_GPL(apple_dart_fay_dump);
+
+/*
+ * fay test (patch 0011): with apple_dart.fay_flush_poff=1 on the command line,
+ * flush the whole DART TLB of @master's DART (FLUSH_ALL, then FLUSH_SID) when
+ * appledrm is about to send setPowerState(0). Tests the stale-cache theory.
+ */
+static bool fay_flush_poff;
+module_param(fay_flush_poff, bool, 0444);
+static unsigned long fay_rb_start;
+module_param(fay_rb_start, ulong, 0444);
+
+void apple_dart_fay_flush(struct device *master, const char *why);
+void apple_dart_fay_flush(struct device *master, const char *why)
+{
+	struct apple_dart_master_cfg *cfg = dev_iommu_priv_get(master);
+	struct apple_dart_stream_map *map;
+	int r1, r2;
+
+	if (!cfg || !cfg->stream_maps[0].dart)
+		return;
+	map = &cfg->stream_maps[0];
+	if (map->dart->hw->type != DART_T8110)
+		return;
+
+	/*
+	 * patch 0013: with apple_dart.fay_rb_start=<PA>>12>, lower the start of
+	 * access region B (0x320, end at 0x328, enable at 0x318; values from the
+	 * ADT dart-tunables) so that it covers that page, e.g. the pmgr dashboard.
+	 */
+	if (fay_rb_start) {
+		u32 before = readl(map->dart->regs + 0x320);
+
+		writel((u32)fay_rb_start, map->dart->regs + 0x320);
+		dev_info(map->dart->dev,
+			 "fay-region: [%s] B start %#x -> wrote %#lx, read back %#x (ctl %#x end %#x)\n",
+			 why, before, fay_rb_start, readl(map->dart->regs + 0x320),
+			 readl(map->dart->regs + 0x318), readl(map->dart->regs + 0x328));
+	}
+	if (!fay_flush_poff)
+		return;
+	r1 = apple_dart_t8110_hw_tlb_command(map, DART_T8110_TLB_CMD_OP_FLUSH_ALL);
+	r2 = apple_dart_t8110_hw_tlb_command(map, DART_T8110_TLB_CMD_OP_FLUSH_SID);
+	dev_info(map->dart->dev, "fay-flush: [%s] FLUSH_ALL rc=%d FLUSH_SID rc=%d tlbcmd %#x\n",
+		 why, r1, r2, readl(map->dart->regs + DART_T8110_TLB_CMD));
+}
+EXPORT_SYMBOL_GPL(apple_dart_fay_flush);
+
+static void apple_dart_fay_setup_pool(struct apple_dart *dart,
+				      struct apple_dart_domain *dart_domain,
+				      struct apple_dart_master_cfg *cfg)
+{
+	phys_addr_t l1_pa, pa;
+	unsigned long used = 0;
+	unsigned int pages, i;
+	bool inside;
+	u64 *l1;
+	void *va;
+	u32 ttbr;
+	int sid;
+
+	if (!fay_pool_dev || strcmp(dev_name(dart->dev), fay_pool_dev))
+		return;
+	if (!dart->locked || dart->hw->fmt != APPLE_DART2) {
+		dev_warn(dart->dev, "fay-pool: only for locked DART2, skipped\n");
+		return;
+	}
+	pages = fay_pool_size / dart->pgsize;
+	if (!pages || pages > BITS_PER_LONG || fay_pool_size % dart->pgsize ||
+	    fay_pool_pa % dart->pgsize) {
+		dev_err(dart->dev, "fay-pool: bad pool %#lx+%#lx, skipped\n",
+			fay_pool_pa, fay_pool_size);
+		return;
+	}
+	if (region_intersects(fay_pool_pa, fay_pool_size, IORESOURCE_SYSTEM_RAM,
+			      IORES_DESC_NONE) != REGION_DISJOINT) {
+		dev_err(dart->dev, "fay-pool: pool overlaps System RAM, skipped\n");
+		return;
+	}
+
+	sid = find_first_bit(cfg->stream_maps[0].sidmap, dart->num_streams);
+	ttbr = readl(dart->regs + DART_TTBR(dart, sid, 0));
+	if (!(ttbr & dart->hw->ttbr_valid)) {
+		dev_err(dart->dev, "fay-pool: sid %d ttbr invalid, skipped\n", sid);
+		return;
+	}
+	ttbr &= ~dart->hw->ttbr_valid;
+	if (dart->hw->ttbr_addr_field_shift)
+		ttbr >>= dart->hw->ttbr_addr_field_shift;
+	l1_pa = ((phys_addr_t)ttbr) << dart->hw->ttbr_shift;
+
+	inside = l1_pa >= fay_pool_pa && l1_pa < fay_pool_pa + fay_pool_size;
+	if (inside)
+		set_bit((l1_pa - fay_pool_pa) / dart->pgsize, &used);
+	dev_info(dart->dev, "fay-pool: sid %d L1 pa %pa (%s the pool)\n", sid,
+		 &l1_pa, inside ? "inside" : "outside");
+
+	/* every table the boot-time L1 still points to stays reserved */
+	l1 = memremap(l1_pa, dart->pgsize, MEMREMAP_WB);
+	if (!l1) {
+		dev_err(dart->dev, "fay-pool: cannot map L1, skipped\n");
+		return;
+	}
+	for (i = 0; i < dart->pgsize / sizeof(*l1); i++) {
+		u64 pte = READ_ONCE(l1[i]);
+
+		if (!(pte & 1))
+			continue;
+		pa = (pte & FAY_DART2_PADDR_MASK) << FAY_DART2_PADDR_SHIFT;
+		if (pa >= fay_pool_pa && pa < fay_pool_pa + fay_pool_size)
+			set_bit((pa - fay_pool_pa) / dart->pgsize, &used);
+		dev_info(dart->dev, "fay-pool: boot L1[%#x] = %#llx -> table pa %pa (%s)\n",
+			 i, pte, &pa,
+			 pa >= fay_pool_pa && pa < fay_pool_pa + fay_pool_size ?
+			 "pool" : "outside");
+	}
+	memunmap(l1);
+
+	va = devm_memremap(dart->dev, fay_pool_pa, fay_pool_size, MEMREMAP_WB);
+	if (IS_ERR_OR_NULL(va)) {
+		dev_err(dart->dev, "fay-pool: cannot map pool, skipped\n");
+		return;
+	}
+	fay_pool_va = va;
+	apple_dart_pgtable_set_pool(dart_domain->pgtbl_ops, fay_pool_pa, va,
+				    pages, used);
+	dev_info(dart->dev, "fay-pool: active, pool %#lx+%#lx (%u pages), used mask %#lx\n",
+		 fay_pool_pa, fay_pool_size, pages, used);
+}
