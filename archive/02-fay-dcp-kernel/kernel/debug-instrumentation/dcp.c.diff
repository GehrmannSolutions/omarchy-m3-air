+static void fay_apf_dump_once(struct apple_dcp *dcp, const char *why)
+{
+	static bool done;
+	void __iomem *apf;
+	unsigned int i;
+
+	/* patch 0018: once at the first debugfs sweep, and at every poff/crash */
+	if (!fay_apf_dump)
+		return;
+	if (!strcmp(why, "debugfs")) {
+		if (done)
+			return;
+		done = true;
+	}
+	apf = ioremap(0x28d310000, 0x4000);
+	if (!apf) {
+		dev_err(dcp->dev, "fay-apf: ioremap failed\n");
+		return;
+	}
+	for (i = 0; i < 16; i++) {
+		void __iomem *sl = apf + i * 0x40;
+
+		dev_info(dcp->dev,
+			 "fay-apf: [%s] slice %2u ctrl %#010x r4 %#010x start %#010x%08x end %#010x%08x r20 %#010x\n",
+			 why, i, readl(sl), readl(sl + 4), readl(sl + 0xc), readl(sl + 8),
+			 readl(sl + 0x14), readl(sl + 0x10), readl(sl + 0x20));
+	}
+	iounmap(apf);
+}
