+	mux-controls = <&atcphy0_xbar 0>;
+	mux-control-names = "dp-xbar";
+	mux-index = <2>;
+	/* fay: as in PR #607 (J514s) */
+	apple,sync-syslog-ack;
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@1 {
+			reg = <1>;
+
+			dcpext_dpout: endpoint {
+				remote-endpoint = <&atcphy0_dp>;
+			};
+		};
+	};
+};
+
+&atcphy0 {
+	ports {
+		port@2 {
+			reg = <2>;
+
+			atcphy0_dp: endpoint {
+				remote-endpoint = <&dcpext_dpout>;
+			};
+		};
+	};
+};
+
+&ps_atc0_common {
+	apple,always-on;
+};
+
+&typec0 {
+	displayport = <&dcpext>;
+};
