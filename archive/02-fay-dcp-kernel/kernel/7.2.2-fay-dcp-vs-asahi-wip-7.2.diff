 #include "hwmon-laptop.dtsi"
+
+/*
+ * fay: DisplayPort alt mode on the left-back USB-C port (typec0, atc0), the
+ * way Asahi's fairydust branch does it for t8112/t602x. Values from the
+ * macOS ADT on this model: dcpext is display-crossbar ufp1, port 0, so the
+ * t602x-type crossbar state is 2 (dispext1,0); atc0-dpxbar sits at
+ * 0x70304c000 with compatible "atc-dpxbar,t602x". dcpext itself is enabled
+ * by m1n1 once its firmware is reserved.
+ */
+/ {
+	aliases {
+		dcpext = &dcpext;
+	};
+};
+
+&display {
+	iommus = <&disp_dart 0>, <&dispext0_dart 0 0x100 0x0 0x10 0x0>;
+};
+
+&dispext0_dart {
+	status = "okay";
+};
+
+&dcpext_dart {
+	status = "okay";
+};
+
+&dcpext_mbox {
+	status = "okay";
+};
+
+&atcphy0_xbar {
+	status = "okay";
+};
+
